<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TROPICAL LETS PLAY ROBLOX</title>
  
  <style>
    /* Сбрасываем отступы и делаем черный фон на весь экран */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #000000;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      font-family: 'Montserrat', 'Arial Black', sans-serif;
    }

    /* Настройки текста и градиента */
    .rainbow-text {
      font-size: 5rem;
      font-weight: 900;
      text-transform: uppercase;
      text-align: center;
      letter-spacing: 3px;
      padding: 20px;
      
      /* Создаем градиент из ярких цветов */
      background: linear-gradient(
        45deg, 
        #ff007f, 
        #ff0000, 
        #ff7f00, 
        #ffff00, 
        #00ff00, 
        #00ffff, 
        #007fff, 
        #7f00ff, 
        #ff007f
      );
      background-size: 400% 400%;
      
      /* Вырезаем текст по градиенту */
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      
      /* Запускаем анимации переливания и плавного появления */
      animation: 
        gradientShift 8s ease infinite,
        fadeIn 2s ease-out forwards;
        
      /* Добавляем мягкое свечение вокруг текста */
      filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.2));
    }

    /* Анимация переливания цветов градиента */
    @keyframes gradientShift {
      0% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
      100% {
        background-position: 0% 50%;
      }
    }

    /* Анимация плавного появления при входе */
    @keyframes fadeIn {
      0% {
        opacity: 0;
        transform: scale(0.9);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* Адаптивность для мобильных телефонов */
    @media (max-width: 768px) {
      .rainbow-text {
        font-size: 2.5rem;
      }
    }
  </style>
</head>
<body>

  <h1 class="rainbow-text">TROPICAL LETS PLAY ROBLOX</h1>

</body>
</html>
